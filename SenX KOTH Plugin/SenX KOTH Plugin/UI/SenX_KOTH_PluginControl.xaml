<UserControl x:Class="SenX_KOTH_Plugin.SenX_KOTH_PluginControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SenX_KOTH_Plugin"
             mc:Ignorable="d"
             xmlns:converters="clr-namespace:KoTH.Converters"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:EnumBooleanConverter x:Key="enumBooleanConverter" />
        <converters:InvertBoolConverter x:Key="InvertBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="NexusWarning" TargetType="TextBlock">
            <Setter Property="Background" Value="#FFF0F0"/>
            <Setter Property="Foreground" Value="#CC0000"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="18" Margin="5">
            <Run Text="SenX K"/><Run Text="o"/><Run Text="TH"/><Run Text="+"/><Run Text=" Plugin"/>
        </TextBlock>

        <TabControl Grid.Row="1" Margin="5">
            <!-- ============ ZONES TAB ============ -->
            <TabItem Header="Zones">
                <StackPanel Margin="10">

                        <GroupBox Header="Managed Zones" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="Zones are created via !koth createzone or the button below. Edit and delete available here." Margin="5" TextWrapping="Wrap"/>
                                <Button Content="Create Zone" Click="CreateZoneButton_Click" Margin="5" HorizontalAlignment="Left"/>

                                <ListBox x:Name="ZonesList" MinHeight="60" Margin="5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="700">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center">
                                                    <Run Text="{Binding Name}"/><Run Text=" ("/><Run Text="{Binding Radius, StringFormat={}{0:F0}m}"/><Run Text=")"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="Win" Click="FireworkWin_Click" Tag="{Binding}" Margin="1" Padding="1" Width="36" ToolTip="Show capture fireworks to all players. Does NOT award points or trigger rewards."/>
                                                <Button Grid.Column="2" Content="Lose" Click="FireworkLose_Click" Tag="{Binding}" Margin="1" Padding="1" Width="37" ToolTip="Show losing fireworks to all players. Does NOT change capture status."/>
                                                <Button Grid.Column="3" Content="Evict" Click="EvictZone_Click" Tag="{Binding}" Margin="1" Padding="1" Width="40" ToolTip="5-second zone evacuation. Does NOT reset capture progress."/>
                                                <Button Grid.Column="4" Content="Reset" Click="ResetZone_Click" Tag="{Binding}" Margin="1" Padding="1" Width="42" ToolTip="Reset capture status to Neutral. Clears all progress."/>
                                                <Button Grid.Column="5" Content="Edit" Click="EditZone_Click" Tag="{Binding}" Margin="1" Padding="1"/>
                                                <Button Grid.Column="6" Content="X" Click="DeleteZone_Click" Tag="{Binding}" Margin="1" Padding="1"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <GroupBox x:Name="ZoneEditorPanel" Header="Zone Editor" Visibility="Collapsed" Padding="10" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Zone Name:"/>
                                        <TextBox x:Name="ZoneEditor_Name" Margin="0,3"/>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="Position X, Y, Z:"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="ZoneEditor_PosX" Width="150" Margin="2,0"/>
                                                <TextBox x:Name="ZoneEditor_PosY" Width="150" Margin="2,0"/>
                                                <TextBox x:Name="ZoneEditor_PosZ" Width="150" Margin="2,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Radius (10-500m):" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ZoneEditor_Radius" Width="60" Margin="5,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Color (R,G,B 0-1):" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ZoneEditor_ColorR" Width="40" Margin="5,0" Text="0.5"/>
                                            <TextBox x:Name="ZoneEditor_ColorG" Width="40" Text="0.8"/>
                                            <TextBox x:Name="ZoneEditor_ColorB" Width="40" Text="0.9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Texture:" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="ZoneEditor_Texture" Width="200" Margin="5,0" IsEditable="True">
                                                <ComboBoxItem>SafeZone_Texture_Default</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Aura</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Organic</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Rain</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Dots</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Disco</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Noise</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Hexagon</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Lines</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Digital</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Gloura</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Clang</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Voronoi</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Restricted</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_KeenSWH</ComboBoxItem>
                                                <ComboBoxItem>SafeZone_Texture_Disabled</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <CheckBox x:Name="ZoneEditor_Enabled" Content="Enabled" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ZoneEditor_PersistVisual" Content="Persist Sphere When Disabled" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <GroupBox Header="Schedule" Margin="0,5" Padding="5">
                                            <StackPanel>
                                                <WrapPanel Margin="0,3">
                                                    <CheckBox x:Name="ZoneEditor_SchedMon" Content="Mon" Margin="0,0,5,0"/>
                                                    <CheckBox x:Name="ZoneEditor_SchedTue" Content="Tue" Margin="0,0,5,0"/>
                                                    <CheckBox x:Name="ZoneEditor_SchedWed" Content="Wed" Margin="0,0,5,0"/>
                                                    <CheckBox x:Name="ZoneEditor_SchedThu" Content="Thu" Margin="0,0,5,0"/>
                                                    <CheckBox x:Name="ZoneEditor_SchedFri" Content="Fri" Margin="0,0,5,0"/>
                                                    <CheckBox x:Name="ZoneEditor_SchedSat" Content="Sat" Margin="0,0,5,0"/>
                                                    <CheckBox x:Name="ZoneEditor_SchedSun" Content="Sun"/>
                                                </WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="Start:" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="ZoneEditor_SchedStartH" Width="30" Margin="3,0"/>
                                                    <TextBlock Text=":" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="ZoneEditor_SchedStartM" Width="30" Margin="0,3"/>
                                                    <TextBlock Text="End:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBox x:Name="ZoneEditor_SchedEndH" Width="30" Margin="3,0"/>
                                                    <TextBlock Text=":" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="ZoneEditor_SchedEndM" Width="30" Margin="0,3"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Capture Settings" Margin="0,5" Padding="5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="Capture Points Needed:" VerticalAlignment="Center" Width="150"/>
                                                    <TextBox x:Name="ZoneEditor_CapturePtsNeeded" Width="60"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="Capture Interval (sec):" VerticalAlignment="Center" Width="150"/>
                                                    <TextBox x:Name="ZoneEditor_CapInterval" Width="60"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="Point Award Interval (sec):" VerticalAlignment="Center" Width="150"/>
                                                    <TextBox x:Name="ZoneEditor_AwardInterval" Width="60"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="Points Per Suit:" VerticalAlignment="Center" Width="150"/>
                                                    <TextBox x:Name="ZoneEditor_PtsSuit" Width="60"/>
                                                    <TextBlock Text="Grids:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                    <TextBox x:Name="ZoneEditor_PtsGrid" Width="60"/>
                                                </StackPanel>
                                                <TextBlock Text="(capture, decay, and point awards)" FontStyle="Italic" FontSize="10" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </GroupBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <CheckBox x:Name="ZoneEditor_Dynamic" Content="Dynamic Zone (random placement)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="Min Dist:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ZoneEditor_MinDist" Width="60" Margin="5,0"/>
                                            <TextBlock Text="Max Dist:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ZoneEditor_MaxDist" Width="60" Margin="5,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="Move Interval (sec):" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ZoneEditor_MoveInterval" Width="60" Margin="5,0"/>
                                            <CheckBox x:Name="ZoneEditor_AnnounceGps" Content="Announce GPS" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <GroupBox Header="Eviction" Margin="0,5" Padding="5">
                                            <StackPanel>
                                                <CheckBox x:Name="ZoneEditor_EvictionEnabled" Content="Eviction Enabled"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="Frequency (min):" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="ZoneEditor_EvictionFreq" Width="50" Margin="5,0"/>
                                                    <TextBlock Text="Duration (sec):" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBox x:Name="ZoneEditor_EvictionDuration" Width="50" Margin="5,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ZoneEditor_EvictionResetCapture" Content="Reset Capture on Eviction" Margin="0,2"/>
                                                <CheckBox x:Name="ZoneEditor_EvictionDowntime" Content="Evict During Downtime" Margin="0,2"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="Color: R" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="ZoneEditor_EvictionColorR" Width="40" Margin="2,0"/>
                                                    <TextBlock Text="G" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                    <TextBox x:Name="ZoneEditor_EvictionColorG" Width="40" Margin="2,0"/>
                                                    <TextBlock Text="B" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                    <TextBox x:Name="ZoneEditor_EvictionColorB" Width="40" Margin="2,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="Texture:" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="ZoneEditor_EvictionTexture" Width="200" Margin="5,0" IsEditable="True">
                                                        <ComboBoxItem>SafeZone_Texture_Default</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Aura</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Organic</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Rain</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Dots</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Disco</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Noise</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Hexagon</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Lines</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Digital</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Gloura</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Clang</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Voronoi</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Restricted</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_KeenSWH</ComboBoxItem>
                                                        <ComboBoxItem>SafeZone_Texture_Disabled</ComboBoxItem>
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Quest Display" Margin="0,5" Padding="5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="Mode:" VerticalAlignment="Center" Width="80"/>
                                                    <ComboBox x:Name="ZoneEditor_QuestMode" Width="140">
                                                        <ComboBoxItem Content="None"/>
                                                        <ComboBoxItem Content="Notifications"/>
                                                        <ComboBoxItem Content="RichHUD"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="Visibility Distance (m):" VerticalAlignment="Center" Width="150"/>
                                                    <TextBox x:Name="ZoneEditor_QuestDist" Width="60"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ZoneEditor_ShowEnemiesOutside" Content="Show Enemies Outside Count" Margin="0,2"/>
                                                <TextBlock Text="Fireworks:" FontWeight="Bold" Margin="0,8,0,2"/>
                                                <CheckBox x:Name="ZoneEditor_EnableWinFireworks" Content="Win Fireworks (on capture)" Margin="0,2"/>
                                                <CheckBox x:Name="ZoneEditor_EnableLoseFireworks" Content="Lose Fireworks (on capture)" Margin="0,2"/>
                                                <TextBlock Text="Discord Announcements:" FontWeight="Bold" Margin="0,8,0,2"/>
                                                <CheckBox x:Name="ZoneEditor_DiscordCapture" Content="Capture" Margin="0,2"/>
                                                <CheckBox x:Name="ZoneEditor_DiscordDecay" Content="Decay" Margin="0,2"/>
                                                <CheckBox x:Name="ZoneEditor_DiscordPoints" Content="Points Earned" Margin="0,2"/>
                                                <CheckBox x:Name="ZoneEditor_DiscordEnter" Content="Player Enter" Margin="0,2"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <Button Content="Save Zone" Click="SaveZone_Click"/>
                                            <Button Content="Cancel" Click="CancelZone_Click" Margin="5,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
            </TabItem>

            <!-- ============ SETTINGS TAB ============ -->
            <TabItem Header="Settings">
                <StackPanel Margin="10">
                        <Button Content="Save Config" Margin="5" Click="SaveButton_OnClick" HorizontalAlignment="Left"/>

                        <GroupBox Header="Data Mode" Margin="0,10">
                            <StackPanel>
                                <RadioButton GroupName="DataMode" IsChecked="{Binding IsDataModeNexus}" Content="Nexus Authority" Margin="5,0"/>
                                <CheckBox IsChecked="{Binding IsDataAuthority}" Content="This server is the authority" Margin="20,3,5,3"
                                          Visibility="{Binding IsDataModeNexus, Converter={StaticResource BoolToVis}}"/>
                                <RadioButton GroupName="DataMode" Content="Shared File Path" Margin="5,0"
                                             IsChecked="{Binding IsDataModeFile, Mode=OneWay}"/>
                                <TextBlock Text="Shared Data Path" Margin="5,10,5,0"/>
                                <Grid Margin="5,0,5,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SharedDataPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"/>
                                    <Button Content="Browse..." Grid.Column="1" Click="BrowseSharedPath_Click" Padding="8,3"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
            </TabItem>

            <!-- ============ REWARDS TAB ============ -->
            <TabItem Header="Rewards">
                <StackPanel Margin="10">

                        <GroupBox Margin="0,5" Padding="3"
                                  Visibility="{Binding IsDataModeFile, Converter={StaticResource BoolToVis}}"
                                  BorderBrush="#E0D8A0" Background="#FFFBE0">
                            <TextBlock Text="Shared file mode: all servers share data. Configure rewards, raffle, and Discord bot on one server only."
                                       Foreground="#8B7500" TextWrapping="Wrap" Padding="3"/>
                        </GroupBox>

                        <TabControl Margin="0,10">
                            <TabItem Header="Reward Settings" IsEnabled="{Binding CanRunEvents}">
                                <StackPanel Margin="10">
                                <TextBlock Text="Rewards are processed automatically at the end of each period. Disable a reward period to skip issuing rewards (points will still cascade to the next period)." Margin="5,0" TextWrapping="Wrap" FontStyle="Italic"/>
                                <CheckBox IsChecked="{Binding WeeklyRewardsEnabled}" Content="Weekly Rewards" Margin="5"/>
                                <CheckBox IsChecked="{Binding MonthlyRewardsEnabled}" Content="Monthly Rewards" Margin="5"/>
                                <CheckBox IsChecked="{Binding YearlyRewardsEnabled}" Content="Yearly Rewards" Margin="5"/>
                            </StackPanel>
                            </TabItem>

                            <TabItem Header="Per-Zone Live Rewards">
                                <StackPanel Margin="10">
                                <TextBlock Text="Capture reward commands fire when a faction fully captures the zone. Use 'Trigger On Every Cap' to allow repeat rewards within the same control cycle." Margin="5" TextWrapping="Wrap"/>
                                <ListBox x:Name="ZoneRewardsList" ItemsSource="{Binding ZoneRewards}" MinHeight="50" Margin="5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="400">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ZoneName}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Edit" Click="EditZoneReward_Click" Tag="{Binding}" Margin="1" Padding="1"/>
                                                <Button Grid.Column="2" Content="X" Click="DeleteZoneReward_Click" Tag="{Binding}" Margin="1" Padding="1"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Add Zone Reward" Click="AddZoneReward_Click" Margin="5" HorizontalAlignment="Left"/>

                                <GroupBox x:Name="ZoneRewardEditorPanel" Header="Zone Reward Editor" Visibility="Collapsed" Padding="10" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Zone Name:"/>
                                        <ComboBox x:Name="ZoneRewardEditor_Name" Margin="0,3"
                                                  ItemsSource="{Binding ZoneNames, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <CheckBox x:Name="ZoneRewardEditor_EveryCap" Content="Trigger On Every Cap" Margin="0,5"
                                                  ToolTip="If checked, reward fires on every capture. If unchecked, only fires once per neutral-captured cycle until the zone resets to neutral."/>

                                        <TextBlock Text="Commands:" FontWeight="Bold" Margin="0,10,0,5"/>
                                        <ListBox x:Name="ZoneRewardCmdList" MinHeight="30">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="400">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding PerFactionMember, StringFormat='[PerMember]'}"/>
                                                            <Run Text="{Binding OnlyOnlineMembers, StringFormat='[Online]'}"/>
                                                            <Run Text=" "/><Run Text="{Binding CommandText}"/>
                                                        </TextBlock>
                                                <Button Grid.Column="1" Content="Edit" Click="EditZoneRewardCmd_Click" Tag="{Binding}" Margin="1" Padding="1" Width="36"/>
                                                <Button Grid.Column="2" Content="X" Click="DeleteZoneRewardCmd_Click" Tag="{Binding}" Margin="1" Padding="1" Width="30"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="Add Command" Click="AddZoneRewardCmd_Click" Margin="0,5" HorizontalAlignment="Left"/>

                                        <GroupBox x:Name="ZoneRewardCmdEditor" Header="Command Editor" Visibility="Collapsed" Padding="8" Margin="0,5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="ZoneCmd_PerFaction" Content="Per Faction Member" Margin="0,0,10,0"/>
                                                    <CheckBox x:Name="ZoneCmd_OnlineOnly" Content="Online Only"/>
                                                </StackPanel>
                                                <TextBlock Text="Command:" Margin="0,5,0,0"/>
                                                <TextBox x:Name="ZoneCmd_Command" Margin="0,3" MinHeight="25"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <Button Content="Confirm" Click="SaveZoneRewardCmd_Click"/>
                                                    <Button Content="Cancel" Click="CancelZoneRewardCmd_Click" Margin="5,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <Button Content="Save Zone Reward" Click="SaveZoneReward_Click"/>
                                            <Button Content="Cancel" Click="CancelZoneReward_Click" Margin="5,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                            </TabItem>

                            <TabItem Header="Rank Rewards" IsEnabled="{Binding CanRunEvents}">
                                <StackPanel Margin="10">
                                <TabControl x:Name="RankPeriodTabs" Margin="5">
                                    <TabItem Header="Weekly">
                                        <StackPanel Margin="10">
                                            <ListBox ItemsSource="{Binding WeeklyRankRewards}" MinHeight="30">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="400">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}"/>
                                                <Button Grid.Column="1" Content="Edit" Click="EditRank_Click" Tag="{Binding}" Margin="1" Padding="1" Width="36"/>
                                                <Button Grid.Column="2" Content="X" Click="DeleteRank_Click" Tag="{Binding}" Margin="1" Padding="1" Width="30"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="Add Weekly Rank" Click="AddRank_Click" Margin="0,5" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Monthly">
                                        <StackPanel Margin="10">
                                            <ListBox ItemsSource="{Binding MonthlyRankRewards}" MinHeight="30">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="400">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}"/>
                                                <Button Grid.Column="1" Content="Edit" Click="EditMonthlyRank_Click" Tag="{Binding}" Margin="1" Padding="1" Width="36"/>
                                                <Button Grid.Column="2" Content="X" Click="DeleteMonthlyRank_Click" Tag="{Binding}" Margin="1" Padding="1" Width="30"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="Add Monthly Rank" Click="AddMonthlyRank_Click" Margin="0,5" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Yearly">
                                        <StackPanel Margin="10">
                                            <ListBox ItemsSource="{Binding YearlyRankRewards}" MinHeight="30">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="400">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}"/>
                                                <Button Grid.Column="1" Content="Edit" Click="EditYearlyRank_Click" Tag="{Binding}" Margin="1" Padding="1" Width="36"/>
                                                <Button Grid.Column="2" Content="X" Click="DeleteYearlyRank_Click" Tag="{Binding}" Margin="1" Padding="1" Width="30"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="Add Yearly Rank" Click="AddYearlyRank_Click" Margin="0,5" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>

                        <GroupBox x:Name="RankEditorPanel" Header="" Visibility="Collapsed" Padding="10" Margin="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RankEditor_Label" Text="Rank Number:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RankEditor_Rank" Width="50" Margin="5,0"/>
