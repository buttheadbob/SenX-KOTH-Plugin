            <!-- ============ DISCORD TAB ============ -->
            <TabItem Header="Discord">
                <StackPanel Margin="10">

                        <GroupBox Margin="0,5" Padding="3"
                                  Visibility="{Binding IsDataModeFile, Converter={StaticResource BoolToVis}}"
                                  BorderBrush="#E0D8A0" Background="#FFFBE0">
                            <TextBlock Text="Shared file mode: all servers share data. Configure Discord bot, rewards, and raffle on one server only."
                                       Foreground="#8B7500" TextWrapping="Wrap" Padding="3"/>
                        </GroupBox>

                        <TabControl Margin="0,10">
                            <TabItem Header="Discord Webhook">
                                <StackPanel Margin="10">
                                <CheckBox IsChecked="{Binding EmbedEnabled}" Content="Embeds Enabled" Margin="5"/>
                                <TextBlock Text="Embed Image URL (optional)" Margin="5,0,0,0"/>
                                <TextBox Margin="5" Text="{Binding EmbedImageUrl}"/>
                                <TextBlock Text="Message Prefix" Margin="5,0,0,0"/>
                                <TextBox Margin="5" Text="{Binding MessagePrefix}"/>
                                <TextBlock Text="Custom Title" Margin="5,0,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Margin="5" Text="{Binding CustomTitle}" Width="200"/>
                                    <CheckBox IsChecked="{Binding CustomTitleEnable}" Content="Enable" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Webhooks" FontWeight="Bold" Margin="5,10,5,5"/>
                                <ListBox x:Name="WebhookList" ItemsSource="{Binding Webhooks}" MinHeight="60">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#CCC" BorderThickness="1" Padding="6" Margin="2" CornerRadius="4">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled}" Content="Enabled" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding AllZones}" Content="All Zones" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBox Grid.Column="2" Text="{Binding ZoneFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                                 IsEnabled="{Binding AllZones, Converter={StaticResource InvertBool}}"
                                                                 ToolTip="Comma-separated zone names"/>
                                                        <Button Grid.Column="3" Content="X" Width="24" Height="24" Margin="4,0,0,0"
                                                                Click="DeleteWebhook_Click" Tag="{Binding}" ToolTip="Delete" Padding="0"/>
                                                    </Grid>
                                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="0,4,0,0">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Url, TargetNullValue='(no URL)', FallbackValue='(no URL)'}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                                        </Expander.Header>
                                                        <StackPanel Margin="0,4,0,0">
                                                            <TextBlock Text="Webhook URL:" Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                                            <TextBlock Text="Events:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                            <WrapPanel>
                                                                <CheckBox IsChecked="{Binding CaptureEvents}" Content="Capture" Margin="0,0,8,0"/>
                                                                <CheckBox IsChecked="{Binding DecayEvents}" Content="Decay" Margin="0,0,8,0"/>
                                                                <CheckBox IsChecked="{Binding PointsEvents}" Content="Points" Margin="0,0,8,0"/>
                                                                <CheckBox IsChecked="{Binding EnterAlerts}" Content="Enter" Margin="0,0,8,0"/>
                                                                <CheckBox IsChecked="{Binding RankResults}" Content="Rank" Margin="0,0,8,0"/>
                                                                <CheckBox IsChecked="{Binding RaffleWinners}" Content="Raffle" Margin="0,0,8,0"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Add Webhook" Click="AddWebhook_Click" Margin="5" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                                    <Button Content="Test Rank" Margin="5" Click="SendSampleRankWebHook_Click"/>
                                    <Button Content="Test Attack" Margin="5" Click="SendSampleAttackWebHook_Click"/>
                                </StackPanel>
                            </StackPanel>
                            </TabItem>

                            <TabItem Header="Discord Bot" IsEnabled="{Binding CanRunEvents}">
                                <StackPanel Margin="10">
                                <CheckBox IsChecked="{Binding DiscordBotEnabled}" Content="Discord Bot Enabled" Margin="5"/>
                                <TextBlock Text="Bot Token" Margin="5,0,0,0"/>
                                <TextBox Margin="5" Text="{Binding DiscordBotToken}"/>
                                <TextBlock Text="Reward Announcement Channel ID" Margin="5,0,0,0"/>
                                <TextBox Margin="5" Text="{Binding RewardChannelId}"/>
                                <TextBlock Text="Live Scoreboard Channel ID" Margin="5,0,0,0"/>
                                <TextBox Margin="5" Text="{Binding LiveScoreboardChannelId}"/>

                                <CheckBox IsChecked="{Binding SelfManagedChannelsEnabled}" Content="Self-Managed Channels (bot creates channels under a category)" Margin="5,10,5,5"/>
                                <TextBlock Text="KoTH Category ID" Margin="5,5,0,0"/>
                                <TextBox Margin="5" Text="{Binding KoTHCategoryId}"/>
                                <TextBlock Text="Guild (Server) ID" Margin="5,0,0,0"/>
                                <TextBox Margin="5" Text="{Binding DiscordGuildId}"/>
                                <StackPanel Orientation="Horizontal" Margin="5,5,5,0">
                                    <TextBlock Text="Update Interval (sec):" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DiscordUpdateIntervalSeconds}" Width="50" Margin="5,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="Channel Name Prefix:" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DiscordChannelPrefix}" Width="100" Margin="5,0"/>
                                </StackPanel>
                            </StackPanel>
                            </TabItem>

                            <TabItem Header="Announcements" IsEnabled="{Binding CanRunEvents}">
                                <StackPanel Margin="10">
                                <CheckBox IsChecked="{Binding Show_WeeklyResults}" Content="Show Weekly Results" Margin="5"/>
                                <CheckBox IsChecked="{Binding Show_MonthlyResults}" Content="Show Monthly Results" Margin="5"/>
                                <CheckBox IsChecked="{Binding Show_YearlyResults}" Content="Show Yearly Results" Margin="5"/>
                            </StackPanel>
                            </TabItem>

                            <TabItem Header="Enter Alerts">
                                <StackPanel Margin="10">
                                <TextBlock Text="Message Template" Margin="5,0,0,0"/>
                                <TextBox Margin="5" Text="{Binding EnterAlert_MessageTemplate}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"/>
                                <TextBlock Text="Variables: {player}, {steamId}, {factionTag}, {factionName}, {zoneName}, {planet}, {x}, {y}, {z}, {radius}, {time}" Margin="5" FontStyle="Italic" TextWrapping="Wrap"/>
                                <Button Content="Test Enter Alert" Margin="5" Click="SendSampleEnterAlertWebHook_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                            </TabItem>
                        </TabControl>

                        <GroupBox Margin="0,10" Padding="3"
                                  Visibility="{Binding IsNexusNonAuthority, Converter={StaticResource BoolToVis}}"
                                  BorderBrush="#E0C0C0" Background="#FFF8F8">
                            <TextBlock Text="This server is not the Nexus authority. Discord bot, live scoreboard, reward announcements, and zone channels will not run on this server."
                                       Foreground="#CC0000" TextWrapping="Wrap" Padding="3"/>
                        </GroupBox>
                    </StackPanel>
            </TabItem>

            <!-- ============ PENDING TAB ============ -->
            <TabItem Header="Pending" Visibility="{Binding IsDataModeNexus, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="10">
                        <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,5">
                            Pending Point Credits
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray">
                            Points earned while the authority server was offline.
                            Cleared automatically when the authority acknowledges them.
                        </TextBlock>
                        <DataGrid x:Name="PendingGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  MinHeight="100">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Faction" Binding="{Binding FactionName}" Width="*"/>
                                <DataGridTextColumn Header="Tag" Binding="{Binding FactionTag}" Width="80"/>
                                <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="80"/>
                                <DataGridTextColumn Header="Zone" Binding="{Binding ZoneName}" Width="*"/>
                                <DataGridTextColumn Header="Earned" Binding="{Binding EarnedAt}" Width="150"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding RequestId}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="PendingCount" Margin="0,5" Foreground="Gray"/>
                        <Button Content="Clear All Pending" Click="ClearPending_Click"
                                HorizontalAlignment="Left" Margin="0,5" Padding="8,3"/>
                    </StackPanel>
            </TabItem>

            <!-- ============ DOCUMENTATION TAB ============ -->
            <TabItem Header="Documentation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock FontWeight="Bold" FontSize="16" Margin="0,0,0,10">
                            <Run Text="SenX K"/><Run Text="o"/><Run Text="TH"/><Run Text="+"/><Run Text=" Plugin Documentation"/>
                        </TextBlock>

                        <CheckBox IsChecked="{Binding DebugLoggingEnabled}" Content="Debug Logging" Margin="0,0,0,5"/>

                        <Expander Header="Player Commands" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run>  !KoTH Week              — Weekly leaderboard</Run><LineBreak/>
                                    <Run>  !KoTH Month             — Monthly leaderboard</Run><LineBreak/>
                                    <Run>  !KoTH Year              — Yearly leaderboard</Run><LineBreak/>
                                    <Run>  !KoTH Zone name         — Per-zone breakdowns</Run><LineBreak/>
                                    <Run>  !KoTH Bank              — Faction bank balance (founder/leader)</Run><LineBreak/>
                                    <Run>  !KoTH BuyTicket [count] — Buy raffle tickets (founder/leader)</Run><LineBreak/>
                                    <Run>  !KoTH About             — This help text</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Admin Commands" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run>  !KoTH CreateZone name [radius] — Create a zone at your position</Run><LineBreak/>
                                    <Run>  !KoTH DeleteZone name         — Delete a zone</Run><LineBreak/>
                                    <Run>  !KoTH GivePoint tag value      — Adjust faction bank points</Run><LineBreak/>
                                    <Run>  !KoTH ForceTest               — Test Discord webhook</Run><LineBreak/>
                                    <Run FontStyle="Italic">  (All commands have a 5-second cooldown)</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Data Modes" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold">Standalone</Run><Run> — Default. Each server is independent.</Run><LineBreak/>
                                    <Run FontWeight="Bold">Nexus Authority</Run><Run> — One server is the authority and holds all bank, raffle, and score data. Non-authority servers relay operations via Nexus. Check the authority checkbox on one server only.</Run><LineBreak/>
                                    <Run FontWeight="Bold">Shared File Path</Run><Run> — Set a network folder. All servers read/write the same files with a file lock. Configure rewards, raffle, and Discord bot on one server only.</Run><LineBreak/><LineBreak/>
                                    <Run>See the Settings tab to configure.</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Zones &amp; Capture" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run>  - Zones use native Space Engineers safe zone entities</Run><LineBreak/>
                                    <Run>  - Created at admin position via !koth createzone or the Zones tab</Run><LineBreak/>
                                    <Run>  - Configurable per zone: radius (10-500m), color, texture, schedule</Run><LineBreak/>
                                    <Run>  - Per-zone schedules: set active days of week and time windows</Run><LineBreak/>
                                    <Run>  - Dynamic zones: random repositioning within an annulus, GPS announcements</Run><LineBreak/>
                                    <Run>  - Capture progress based on suits and grids inside each zone</Run><LineBreak/>
                                    <Run>  - Separate capture and decay rates per suit and grid</Run><LineBreak/>
                                    <Run>  - States: Neutral -> Capturing -> Captured (or Contested -> Decaying -> Neutral)</Run><LineBreak/>
                                    <Run>  - Points awarded to the holding faction at configurable intervals</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Quest Display (HUD)" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run>  - Shows zone status to players within the configured visibility distance</Run><LineBreak/>
                                    <Run>  - Three modes per zone: None / Notifications / RichHUD</Run><LineBreak/>
                                    <Run>  - Notification mode: status pops up as built-in SE notifications (1s refresh)</Run><LineBreak/>
                                    <Run>  - RichHUD mode: persistent HUD overlay (requires "Senx Koth" mod — see below)</Run><LineBreak/>
                                    <Run>  - If you prefer no mod dependency, use None or Notifications mode instead</Run><LineBreak/>
                                    <Run>  - Optional enemies outside counter (players near but outside capture area)</Run><LineBreak/>
                                    <Run FontWeight="Bold">  States displayed:</Run><LineBreak/>
                                    <Run>    Neutral       — "Neutral"</Run><LineBreak/>
                                    <Run>    Capturing     — Capturing [%], Time Remaining, Enemies Outside</Run><LineBreak/>
                                    <Run>    Contested     — Contested [%], Enemies Inside, Enemies Outside</Run><LineBreak/>
                                    <Run>    Decaying      — Decay [%], Time Remaining</Run><LineBreak/>
                                    <Run>    Captured      — Held by [Faction Tag]</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Evictions" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run>  - Per-zone configurable periodic eviction events</Run><LineBreak/>
                                    <Run>  - 30-second and 10-second warnings before eviction takes effect</Run><LineBreak/>
                                    <Run>  - Option to reset capture progress on eviction</Run><LineBreak/>
                                    <Run>  - Custom eviction zone color, texture, and duration</Run><LineBreak/>
                                    <Run>  - Evictions can run during zone downtime (schedule off-hours)</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Fireworks" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run>Capture fireworks burst from the zone center on capture.</Run><LineBreak/>
                                    <Run>  - Per-zone toggles: Win Fireworks / Lose Fireworks (zone editor)</Run><LineBreak/>
                                    <Run>  - Fireworks only trigger once per capture</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Zone Controls (Buttons)" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold">Managed Zones buttons:</Run><LineBreak/>
                                    <Run>  Win   - Show capture fireworks (no points)</Run><LineBreak/>
                                    <Run>  Lose  - Show losing fireworks (no capture change)</Run><LineBreak/>
                                    <Run>  Evict - 5s evacuation, no capture reset</Run><LineBreak/>
                                    <Run>  Reset - Reset to Neutral, clear progress</Run><LineBreak/><LineBreak/>
                                    <Run FontWeight="Bold">Zone editor Discord toggles:</Run><LineBreak/>
                                    <Run>  Capture / Decay / Points Earned / Player Enter announcements</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="RichHUD Mod" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold">Required for RichHUD display mode. Without it, use None or Notifications.</Run><LineBreak/>
                                    <Run>  - The "Senx Koth" mod must be deployed as a server-side mod</Run><LineBreak/>
                                    <Run>  - Requires RichHudMaster mod installed on server and all clients</Run><LineBreak/>
                                    <Run>  - Displays a semi-transparent HUD panel at the top-left of the screen</Run><LineBreak/>
                                    <Run>  - Shows zone status, capture progress, time remaining, and enemy counts</Run><LineBreak/>
                                    <Run>  - Auto-hides when the player leaves the configured visibility distance</Run><LineBreak/>
                                    <Run>  - Updates every second — no game-thread dependency</Run><LineBreak/>
                                    <Run>  - Shows the closest in-range zone when multiple zones are active</Run><LineBreak/>
                                    <Run>  - Eviction warnings shown with countdown when active</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Discord" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold">Discord Bot:</Run><LineBreak/>
                                    <Run>  - Enable on the Discord tab with a bot token</Run><LineBreak/>
                                    <Run>  - Posts reward announcements and live scoreboard updates</Run><LineBreak/>
                                    <Run>  - Self-managed channels: bot creates per-zone channels under a category</Run><LineBreak/><LineBreak/>
                                    <Run FontWeight="Bold">Discord Webhooks:</Run><LineBreak/>
                                    <Run>  - Local only — each server manages its own webhooks independently</Run><LineBreak/>
                                    <Run>  - Add one or more webhook URLs; each can filter by event type and zone</Run><LineBreak/>
                                    <Run>  - Event types: Capture, Decay, Points, Enter Alert, Rank Results, Raffle</Run><LineBreak/>
                                    <Run>  - Zone filter: check "All Zones" for all zones, or list specific zones (comma-separated)</Run><LineBreak/>
                                    <Run>  - Webhooks are NOT relayed via Nexus — each server sends its own</Run><LineBreak/><LineBreak/>
                                    <Run FontWeight="Bold">Nexus Discord Relay:</Run><LineBreak/>
                                    <Run>  - Nexus Send: broadcasts zone/reward events to other servers in the cluster</Run><LineBreak/>
                                    <Run>  - Nexus Receive: posts received broadcasts using the local Discord bot</Run><LineBreak/>
                                    <Run>  - Requires a Discord bot on every server that receives broadcasts</Run><LineBreak/>
                                    <Run>  - Does NOT forward webhooks — bots only</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Raffle" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap">
                                    <Run>  - Factions earn bank points from zone captures</Run><LineBreak/>
                                    <Run>  - Founder/leader buys tickets with bank points</Run><LineBreak/>
                                    <Run>  - Scheduled weekly or monthly draws with 1st/2nd/3rd place rewards</Run><LineBreak/>
                                    <Run>  - Tickets reset each draw; bank points never expire</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Data Files" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas">
                                    <Run FontStyle="Italic">Location: Torch Instance\Senx_Koth\</Run><LineBreak/><LineBreak/>
                                    <Run FontWeight="Bold">All servers:</Run><LineBreak/>
                                    <Run>  Config.json, Zones.json, EventData.json</Run><LineBreak/><LineBreak/>
                                    <Run FontWeight="Bold">Authority / shared path:</Run><LineBreak/>
                                    <Run>  FactionBanks.json, RaffleTickets.json, ScoreData.json</Run><LineBreak/><LineBreak/>
                                    <Run FontWeight="Bold">Non-authority (Nexus):</Run><LineBreak/>
                                    <Run>  PendingTransactions.json</Run><LineBreak/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
